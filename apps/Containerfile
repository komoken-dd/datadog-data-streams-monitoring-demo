ARG MAVEN_IMAGE=docker.io/library/maven@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

# No bundled Java process runs before its pinned security replacement.
FROM --platform=$BUILDPLATFORM ${MAVEN_IMAGE} AS java-build
ARG BUILDARCH
ARG JAVA_JDK_AMD64_SHA256=bb8a93f9ae6e7a693b2b721e85dbeff26ae1a77447985a8d7afcdd9c7cf6222e
ARG JAVA_JDK_ARM64_SHA256=8c72816a6b308842d5ed1f13e5826b69c567da4784f7238d7e800efa71fe54b1
RUN set -eu; \
    case "$BUILDARCH" in \
      amd64) java_arch=x64; java_sha="$JAVA_JDK_AMD64_SHA256" ;; \
      arm64) java_arch=aarch64; java_sha="$JAVA_JDK_ARM64_SHA256" ;; \
      *) echo 'Unsupported build architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error --retry 3 \
      "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13.1%2B2/OpenJDK21U-jdk_${java_arch}_linux_hotspot_21.0.13.1_2.tar.gz" \
      --output /tmp/patched-jdk.tar.gz; \
    printf '%s  %s\n' "$java_sha" /tmp/patched-jdk.tar.gz | sha256sum --check --status; \
    rm -rf /opt/java/openjdk; mkdir -p /opt/java/openjdk; \
    tar --extract --gzip --file /tmp/patched-jdk.tar.gz --directory /opt/java/openjdk --strip-components=1 --no-same-owner; \
    rm /tmp/patched-jdk.tar.gz; \
    grep -Fx 'JAVA_VERSION="21.0.13.1"' /opt/java/openjdk/release; \
    java -version
ENV JAVA_VERSION=jdk-21.0.13.1+2

# Transform target filesystem as data on the build architecture: no QEMU is
# needed. The final flattened filesystem contains no superseded JVM files.
FROM ${RUNTIME_IMAGE} AS runtime-source
FROM java-build AS runtime-rootfs
ARG TARGETARCH
ARG JAVA_JRE_AMD64_SHA256=18f44fab9065217f3ba61d0eef8a7b5f3c3713aa7293001b0d4ac10ede3850f0
ARG JAVA_JRE_ARM64_SHA256=52bc58323d9266538a6361a3cf8365fc1186dd9510d7f33f623681c4aabb7e72
COPY --from=runtime-source / /runtime-rootfs/
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) java_arch=x64; java_sha="$JAVA_JRE_AMD64_SHA256" ;; \
      arm64) java_arch=aarch64; java_sha="$JAVA_JRE_ARM64_SHA256" ;; \
      *) echo 'Unsupported target architecture' >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error --retry 3 \
      "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13.1%2B2/OpenJDK21U-jre_${java_arch}_linux_hotspot_21.0.13.1_2.tar.gz" \
      --output /tmp/patched-jre.tar.gz; \
    printf '%s  %s\n' "$java_sha" /tmp/patched-jre.tar.gz | sha256sum --check --status; \
    rm -rf /runtime-rootfs/opt/java/openjdk; mkdir -p /runtime-rootfs/opt/java/openjdk; \
    tar --extract --gzip --file /tmp/patched-jre.tar.gz --directory /runtime-rootfs/opt/java/openjdk --strip-components=1 --no-same-owner; \
    rm /tmp/patched-jre.tar.gz; \
    grep -Fx 'JAVA_VERSION="21.0.13.1"' /runtime-rootfs/opt/java/openjdk/release

FROM java-build AS extractor
ARG JAR_FILE=target/*.jar
WORKDIR /build
COPY ${JAR_FILE} application.jar
RUN java -Djarmode=tools -jar application.jar \
    extract --layers --destination extracted

FROM scratch
ARG VCS_REF=unknown
ARG IMAGE_VERSION=unknown
ARG IMAGE_CREATED=2026-01-01T00:00:00Z
COPY --from=runtime-rootfs /runtime-rootfs/ /
ENV JAVA_HOME=/opt/java/openjdk \
    JAVA_VERSION=jdk-21.0.13.1+2 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /app
COPY --from=extractor /build/extracted/dependencies/ ./
COPY --from=extractor /build/extracted/spring-boot-loader/ ./
COPY --from=extractor /build/extracted/snapshot-dependencies/ ./
COPY --from=extractor /build/extracted/application/ ./
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "application.jar"]
LABEL org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}" \
      org.opencontainers.image.source="https://github.com/komoken-dd/datadog-data-streams-monitoring-demo" \
      io.brokerage-demo.java.version="21.0.13.1+2"
