{
  "type": "record",
  "name": "OrderAcceptedEvent",
  "namespace": "io.github.komokendd.dsm.brokerage.schema",
  "doc": "Customer order accepted by order-service after a synchronous buying-power or sellable-quantity reservation.",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "ORDER_ACCEPTED"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "accountId",
      "type": "string"
    },
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "symbol",
      "type": "string"
    },
    {
      "name": "side",
      "type": "string",
      "doc": "BUY or SELL"
    },
    {
      "name": "demoScenarioId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "orderType",
      "type": "string",
      "doc": "MARKET or LIMIT"
    },
    {
      "name": "quantity",
      "type": "long",
      "doc": "Shares; a multiple of the 100-share trading unit"
    },
    {
      "name": "limitPrice",
      "type": [
        "null",
        {
          "type": "bytes",
          "logicalType": "decimal",
          "precision": 12,
          "scale": 1
        }
      ],
      "default": null
    },
    {
      "name": "reservedAmountJpy",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 0
      },
      "doc": "Cash reserved for BUY orders; zero for SELL"
    },
    {
      "name": "acceptedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
