{
  "type": "record",
  "name": "NotificationRequest",
  "namespace": "io.github.komokendd.dsm.brokerage.schema",
  "doc": "Customer notification to deliver through the push provider.",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "NOTIFICATION_REQUESTED"
    },
    {
      "name": "eventVersion",
      "type": "int",
      "default": 1
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "accountId",
      "type": "string"
    },
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "symbol",
      "type": "string"
    },
    {
      "name": "side",
      "type": "string",
      "doc": "BUY or SELL"
    },
    {
      "name": "demoScenarioId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "notificationId",
      "type": "string",
      "doc": "Deterministic from the source event; the push provider deduplicates on it"
    },
    {
      "name": "sourceEventId",
      "type": "string"
    },
    {
      "name": "notificationType",
      "type": "string",
      "doc": "EXECUTION or EXPIRY"
    },
    {
      "name": "quantity",
      "type": "long",
      "doc": "Executed or expired quantity"
    },
    {
      "name": "price",
      "type": [
        "null",
        {
          "type": "bytes",
          "logicalType": "decimal",
          "precision": 12,
          "scale": 1
        }
      ],
      "default": null
    },
    {
      "name": "sourceOccurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "requestedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
