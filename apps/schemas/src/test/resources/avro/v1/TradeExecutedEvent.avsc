{
  "type": "record",
  "name": "TradeExecutedEvent",
  "namespace": "io.github.komokendd.dsm.fx.schema",
  "fields": [
    {"name":"eventId","type":"string"},
    {"name":"orderId","type":"string"},
    {"name":"eventType","type":"string","default":"TRADE_EXECUTED"},
    {"name":"eventVersion","type":"int","default":1},
    {"name":"occurredAt","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"currencyPair","type":"string"},
    {"name":"demoScenarioId","type":["null","string"],"default":null},
    {"name":"executionId","type":"string"},
    {"name":"side","type":"string"},
    {"name":"quantity","type":{"type":"bytes","logicalType":"decimal","precision":19,"scale":2}},
    {"name":"executionPrice","type":{"type":"bytes","logicalType":"decimal","precision":19,"scale":6}},
    {"name":"notionalUsd","type":{"type":"bytes","logicalType":"decimal","precision":19,"scale":2}},
    {"name":"submittedAt","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"executedAt","type":{"type":"long","logicalType":"timestamp-millis"}}
  ]
}
