#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
source "${PROJECT_ROOT}/config/container-images.sh"
source "${PROJECT_ROOT}/scripts/image-sources.sh"

require_command podman

readonly NO_CACHE="${NO_CACHE:-false}"
readonly PUSH="${PUSH:-false}"
require_boolean NO_CACHE
require_boolean PUSH
# Keep this epoch aligned with project.build.outputTimestamp in apps/pom.xml.
readonly CONTAINER_SOURCE_DATE_EPOCH=1767225600
readonly CONTAINER_CREATED="2026-01-01T00:00:00Z"

TARGET="${TARGET:-kind}"
podman_arch="$(podman info --format '{{.Host.Arch}}')"
case "${podman_arch}" in
  amd64|x86_64) podman_arch="amd64" ;;
  arm64|aarch64) podman_arch="arm64" ;;
  *) die "Unsupported Podman machine architecture: ${podman_arch}" ;;
esac
readonly BUILD_PLATFORM="linux/${podman_arch}"

case "${TARGET}" in
  kind)
    detected_platform="${BUILD_PLATFORM}"
    REPOSITORY_PREFIX="${REPOSITORY_PREFIX:-localhost/brokerage-demo}"
    IMAGE_TAG="${IMAGE_TAG:-0.1.0}"
    ;;
  eks)
    require_command kubectl
    require_nonempty BROKERAGE_DEMO_EKS_CONTEXT
    require_exact_context "${BROKERAGE_DEMO_EKS_CONTEXT}"
    eks_node_architectures="$(kubectl --context "${BROKERAGE_DEMO_EKS_CONTEXT}" get nodes \
      -o jsonpath='{range .items[*]}{.status.nodeInfo.architecture}{"\n"}{end}' \
      | sed '/^$/d' | LC_ALL=C sort -u)"
    case "${eks_node_architectures}" in
      amd64|arm64) detected_platform="linux/${eks_node_architectures}" ;;
      "") die "No EKS worker node architecture could be detected." ;;
      *) die "Self-built images require one EKS node architecture; found: ${eks_node_architectures//$'\n'/, }." ;;
    esac
    require_nonempty REPOSITORY_PREFIX
    require_nonempty IMAGE_TAG
    ;;
  *)
    echo "TARGET must be 'kind' or 'eks'." >&2
    exit 1
    ;;
esac

if [[ -n "${PLATFORM:-}" && "${PLATFORM}" != "${detected_platform}" ]]; then
  die "PLATFORM=${PLATFORM} does not match the detected ${TARGET} architecture (${detected_platform})."
fi
readonly PLATFORM="${detected_platform}"
readonly MAVEN_IMAGE="${MAVEN_IMAGE:-${MAVEN_IMAGE_MULTIARCH}}"
readonly RUNTIME_IMAGE="${RUNTIME_IMAGE:-${JAVA_RUNTIME_IMAGE_MULTIARCH}}"

echo "Build target: ${TARGET}"
echo "Build platform: ${BUILD_PLATFORM}"
echo "Target platform: ${PLATFORM}"
echo "Image prefix: ${REPOSITORY_PREFIX}"
echo "Immutable image tag: ${IMAGE_TAG}"
echo "Maven builder: ${MAVEN_IMAGE} (${MAVEN_IMAGE_TAG})"
echo "Java runtime: ${RUNTIME_IMAGE} (${JAVA_RUNTIME_IMAGE_TAG})"

vcs_ref="${VCS_REF:-unknown}"
if [[ "${vcs_ref}" == "unknown" ]] && command -v git >/dev/null 2>&1; then
  vcs_ref="$(git -C "${PROJECT_ROOT}" rev-parse HEAD 2>/dev/null || printf 'unknown')"
fi
readonly vcs_ref
echo "Source revision: ${vcs_ref}"

selected_services=("${BROKERAGE_DEMO_SERVICES[@]}")
if [[ $# -gt 0 ]]; then
  selected_services=("$@")
fi

for service in "${selected_services[@]}"; do
  if [[ " ${BROKERAGE_DEMO_SERVICES[*]} " != *" ${service} "* ]]; then
    echo "Unknown service: ${service}" >&2
    exit 1
  fi
done

if [[ "${TARGET}" == "eks" && "${PUSH}" == "true" && $# -gt 0 ]]; then
  die "TARGET=eks PUSH=true must build and push all ten services as one release unit."
fi

push_work_dir=""
cleanup_push_work_dir() {
  [[ -z "${push_work_dir}" ]] && return 0
  case "${push_work_dir}" in
    "${TMPDIR:-/tmp}"/brokerage-demo-push.*) rm -rf -- "${push_work_dir}" ;;
    *) echo "Refusing to remove unexpected push directory: ${push_work_dir}" >&2 ;;
  esac
}
trap cleanup_push_work_dir EXIT

pushed_references=()
if [[ "${TARGET}" == "eks" && "${PUSH}" == "true" ]]; then
  require_command jq
  push_work_dir="$(mktemp -d "${TMPDIR:-/tmp}/brokerage-demo-push.XXXXXX")"
fi

maven_modules="$(IFS=,; echo "${selected_services[*]}")"
mkdir -p "${PROJECT_ROOT}/apps/.m2"
podman run --rm \
  --platform "${BUILD_PLATFORM}" \
  --volume "${PROJECT_ROOT}/apps:/workspace" \
  --volume "${PROJECT_ROOT}/apps/.m2:/root/.m2" \
  --workdir /workspace \
  "${MAVEN_IMAGE}" \
  mvn -B -pl "${maven_modules}" -am clean package -DskipTests

for service in "${selected_services[@]}"; do
  image="${REPOSITORY_PREFIX}/${service}:${IMAGE_TAG}"
  build_args=(
    build
    --platform "${PLATFORM}"
    --source-date-epoch "${CONTAINER_SOURCE_DATE_EPOCH}"
    --rewrite-timestamp
    --build-arg "VCS_REF=${vcs_ref}"
    --build-arg "IMAGE_VERSION=${IMAGE_TAG}"
    --build-arg "IMAGE_CREATED=${CONTAINER_CREATED}"
    --build-arg "RUNTIME_IMAGE=${RUNTIME_IMAGE}"
    --tag "${image}"
    --file "${PROJECT_ROOT}/apps/Containerfile"
    --ignorefile "${PROJECT_ROOT}/apps/.containerignore"
  )
  if [[ "${NO_CACHE}" == "true" ]]; then
    build_args+=(--no-cache)
  fi
  build_args+=("${PROJECT_ROOT}/apps/${service}")
  podman "${build_args[@]}"
  if [[ "${PUSH}" == "true" ]]; then
    if [[ "${TARGET}" == "eks" ]]; then
      digest_file="${push_work_dir}/${service}.digest"
      podman push --digestfile "${digest_file}" "${image}"
      digest="$(<"${digest_file}")"
      [[ "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "Registry returned an invalid digest for ${image}: ${digest}"
      pushed_references+=("${image}@${digest}")
    else
      podman push "${image}"
    fi
  fi
done

if [[ "${TARGET}" == "eks" && "${PUSH}" == "true" ]]; then
  readonly BROKERAGE_DEMO_IMAGE_VALUES_FILE="${BROKERAGE_DEMO_IMAGE_VALUES_FILE:-${PROJECT_ROOT}/deploy/values/values-self-built.json}"
  references_json='{}'
  for index in "${!BROKERAGE_DEMO_SERVICES[@]}"; do
    references_json="$(jq -cn \
      --argjson references "${references_json}" \
      --arg service "${BROKERAGE_DEMO_SERVICES[$index]}" \
      --arg reference "${pushed_references[$index]}" \
      '$references + {($service): $reference}')"
  done
  mkdir -p "$(dirname "${BROKERAGE_DEMO_IMAGE_VALUES_FILE}")"
  temporary_values_file="${push_work_dir}/values-self-built.json"
  jq -n \
    --arg version "${IMAGE_TAG}" \
    --argjson references "${references_json}" \
    '{version: $version, image: {references: $references}}' >"${temporary_values_file}"
  mv "${temporary_values_file}" "${BROKERAGE_DEMO_IMAGE_VALUES_FILE}"
  validate_self_built_image_values "${BROKERAGE_DEMO_IMAGE_VALUES_FILE}"
  echo "Self-built image values written to ${BROKERAGE_DEMO_IMAGE_VALUES_FILE}"
fi
