#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"

action="${1:-}"

if [[ -z "${action}" ]]; then
  echo "Usage: scripts/datadog-terraform <init|validate|test|plan|apply|output|destroy-plan|destroy-apply>" >&2
  exit 1
fi

require_command terraform
require_command python3
umask 077

# Additional CLI arguments can override var files or select another backend.
# Keep the wrapper's reviewed inputs authoritative.
for name in $(compgen -e | sed -n '/^TF_CLI_ARGS/p') TF_WORKSPACE; do
  [[ -z "${!name:-}" ]] || die "Unset ${name}; this wrapper selects its inputs and backend explicitly."
done
[[ $# -eq 1 ]] || die "Pass one action only; configure the target with BROKERAGE_DEMO_TF_STATE and BROKERAGE_DEMO_TFVARS."

readonly terraform_dir="${PROJECT_ROOT}/infra/datadog-terraform"
readonly guard="${PROJECT_ROOT}/scripts/terraform-plan-guard.py"
readonly state_file="$(python3 "${guard}" canonical "${BROKERAGE_DEMO_TF_STATE:-${terraform_dir}/.terraform-state/terraform.tfstate}")"
readonly var_file="$(python3 "${guard}" canonical "${BROKERAGE_DEMO_TFVARS:-${terraform_dir}/local.auto.tfvars}")"
readonly scope="$(python3 "${guard}" scope "${state_file}")"
readonly data_dir="${terraform_dir}/.terraform-profiles/${scope}"
readonly test_data_dir="${terraform_dir}/.terraform-test"
readonly plan_dir="${terraform_dir}/.terraform-plans/${scope}"
readonly plan_file="${plan_dir}/brokerage-demo.tfplan"
readonly destroy_plan_file="${plan_dir}/brokerage-demo-destroy.tfplan"
export TF_DATA_DIR="${data_dir}"

# Backend initialization changes local metadata; serialize it with planning and
# applying, including between processes using different tfvars for the same state.
mkdir -p "${terraform_dir}/.terraform-profiles"
lock_dir="${terraform_dir}/.terraform-profiles/${scope}.lock"
[[ "${action}" != test ]] || lock_dir="${terraform_dir}/.terraform-profiles/tests.lock"
mkdir "${lock_dir}" 2>/dev/null || die "Another Terraform operation holds ${lock_dir}. Remove it only after confirming that process has stopped."
trap 'plan_guard_exit_status=$?; rmdir "${lock_dir}" || true; exit "${plan_guard_exit_status}"' EXIT

plan_guard() {
  local operation="$1" kind="$2" file="$3"
  python3 "${guard}" "${operation}" "${terraform_dir}" "${state_file}" "${var_file}" "${DD_SITE}" "${kind}" "${file}" "${file}.json"
}

create_plan() {
  local kind="$1" file="$2"
  local -a arguments=(-input=false)
  [[ "${kind}" != destroy ]] || arguments+=(-destroy)
  mkdir -p "${plan_dir}"
  # A failed replacement must never leave a previous approved plan usable.
  rm -f -- "${file}" "${file}.json"
  terraform -chdir="${terraform_dir}" plan "${arguments[@]}" \
    -var-file="${var_file}" -out="${file}"
  if ! terraform -chdir="${terraform_dir}" show -json "${file}" | plan_guard record "${kind}" "${file}"; then
    rm -f -- "${file}" "${file}.json"
    die "Plan verification failed; no applicable plan was retained."
  fi
  echo "Saved ${kind} plan: ${file}"
}

apply_plan() {
  local kind="$1" file="$2"
  require_tfvars
  require_nonempty DD_SITE
  [[ -f "${file}" && -f "${file}.json" ]] || die "Missing saved ${kind} plan and identity manifest. Generate and review a plan for the selected state first."
  plan_guard verify "${kind}" "${file}"
  initialize
  preflight
  # Consume before applying. A failed/partial apply needs a fresh reviewed plan.
  mv -- "${file}" "${file}.applying"
  rm -f -- "${file}.json"
  local status=0
  terraform -chdir="${terraform_dir}" apply -input=false "${file}.applying" || status=$?
  rm -f -- "${file}.applying"
  return "${status}"
}

initialize() {
  mkdir -p "$(dirname "${state_file}")" "${data_dir}"
  terraform -chdir="${terraform_dir}" init \
    -input=false \
    -reconfigure \
    -backend-config="path=${state_file}"
}

require_tfvars() {
  if [[ ! -f "${var_file}" ]]; then
    echo "Missing Terraform variables: ${var_file}" >&2
    echo "Copy ${terraform_dir}/example.tfvars to ${var_file} and replace the placeholder values." >&2
    exit 1
  fi
}

preflight() {
  require_tfvars
  require_nonempty DD_SITE
  require_datadog_credentials
  echo "Terraform state: ${state_file}"
  echo "Terraform variables: ${var_file}"
}

case "${action}" in
  init)
    initialize
    ;;
  validate)
    initialize
    terraform -chdir="${terraform_dir}" validate
    ;;
  test)
    mkdir -p "${test_data_dir}"
    TF_DATA_DIR="${test_data_dir}" terraform -chdir="${terraform_dir}" init \
      -input=false \
      -backend=false
    TF_DATA_DIR="${test_data_dir}" terraform -chdir="${terraform_dir}" test
    ;;
  plan)
    initialize
    preflight
    create_plan update "${plan_file}"
    ;;
  apply)
    apply_plan update "${plan_file}"
    ;;
  output)
    initialize
    terraform -chdir="${terraform_dir}" output
    ;;
  destroy-plan)
    initialize
    preflight
    create_plan destroy "${destroy_plan_file}"
    ;;
  destroy-apply)
    if [[ "${CONFIRM_DATADOG_DESTROY:-}" != "brokerage-demo" ]]; then
      echo "Refusing to destroy: set CONFIRM_DATADOG_DESTROY=brokerage-demo." >&2
      exit 1
    fi
    apply_plan destroy "${destroy_plan_file}"
    ;;
  *)
    echo "Unknown action: ${action}" >&2
    exit 1
    ;;
esac
