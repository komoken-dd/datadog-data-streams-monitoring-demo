#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"

require_command kubectl
require_command curl

target="${1:-}"
action="${2:-}"

case "${target}" in
  kind) expected_context="kind-brokerage-demo" ;;
  eks)
    require_nonempty BROKERAGE_DEMO_EKS_CONTEXT
    expected_context="${BROKERAGE_DEMO_EKS_CONTEXT}"
    ;;
  *) echo "Usage: scripts/demo-control <kind|eks> <baseline|stop|opening-rush|sell-off|buying-power-delay|push-outage|redrive>" >&2; exit 1 ;;
esac
require_exact_context "${expected_context}"

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do kill "${pid}" 2>/dev/null || true; done
}
trap cleanup EXIT

call_control() {
  local service="$1"
  local port="$2"
  local path="$3"
  start_port_forward "${service}" "${port}"
  pids+=("${PORT_FORWARD_PID}")
  curl -fsS -X POST "http://127.0.0.1:${port}${path}"
  echo
}

case "${action}" in
  baseline)
    call_control order-flow-simulator 18081 /internal/demo/baseline
    call_control exchange-gateway-simulator 18082 /internal/demo/reset
    call_control buying-power-service 18083 /internal/demo/recover
    call_control push-gateway-simulator 18084 /internal/demo/recover
    ;;
  stop) call_control order-flow-simulator 18081 /internal/demo/stop ;;
  opening-rush) call_control order-flow-simulator 18081 /internal/demo/opening-rush ;;
  sell-off) call_control order-flow-simulator 18081 /internal/demo/sell-off ;;
  buying-power-delay) call_control buying-power-service 18083 /internal/demo/delay ;;
  push-outage) call_control push-gateway-simulator 18084 /internal/demo/outage ;;
  redrive) call_control exception-management-service 18085 /internal/demo/redrive ;;
  *) echo "Unknown action: ${action}" >&2; exit 1 ;;
esac
