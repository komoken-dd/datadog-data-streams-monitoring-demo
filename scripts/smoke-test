#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"

require_command kubectl
require_command curl
require_command jq

target="${1:-}"
case "${target}" in
  kind) expected_context="kind-fx-demo" ;;
  eks)
    require_nonempty FX_DEMO_EKS_CONTEXT
    expected_context="${FX_DEMO_EKS_CONTEXT}"
    ;;
  *) echo "Usage: scripts/smoke-test <kind|eks>" >&2; exit 1 ;;
esac
require_exact_context "${expected_context}"

kubectl -n "${FX_NAMESPACE}" wait kafka/fx-kafka --for=condition=Ready --timeout=5m
kubectl -n "${FX_NAMESPACE}" wait --for=condition=Available deployment --all --timeout=8m

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do kill "${pid}" 2>/dev/null || true; done
}
trap cleanup EXIT

start_port_forward order-service 18084
pids+=("${PORT_FORWARD_PID}")
start_port_forward order-state-service 18085
pids+=("${PORT_FORWARD_PID}")

response="$(curl -fsS -X POST http://127.0.0.1:18084/orders \
  -H 'Content-Type: application/json' \
  -d '{"currencyPair":"USD/JPY","side":"BUY","quantity":100000.00,"limitPrice":148.250000}')"
order_id="$(jq -er '.orderId' <<<"${response}")"
echo "Submitted smoke-test order: ${order_id}"

for _ in {1..60}; do
  if state="$(curl -fsS "http://127.0.0.1:18085/internal/orders/${order_id}" 2>/dev/null)"; then
    status="$(jq -r '.status' <<<"${state}")"
    echo "Observed status: ${status}"
    if [[ "${status}" == "SETTLEMENT_INSTRUCTED" ]]; then
      echo "Successful end-to-end pipeline verified."
      exit 0
    fi
  fi
  sleep 1
done

echo "Order did not reach SETTLEMENT_INSTRUCTED within 60 seconds." >&2
exit 1
