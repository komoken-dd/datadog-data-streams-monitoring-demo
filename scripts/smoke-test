#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"

require_command kubectl
require_command curl
require_command jq

target="${1:-}"
case "${target}" in
  kind) expected_context="kind-brokerage-demo" ;;
  eks)
    require_nonempty BROKERAGE_DEMO_EKS_CONTEXT
    expected_context="${BROKERAGE_DEMO_EKS_CONTEXT}"
    ;;
  *) echo "Usage: scripts/smoke-test <kind|eks>" >&2; exit 1 ;;
esac
require_exact_context "${expected_context}"

kubectl -n "${BROKERAGE_NAMESPACE}" wait kafka/brokerage-kafka --for=condition=Ready --timeout=5m
kubectl -n "${BROKERAGE_NAMESPACE}" wait --for=condition=Available deployment --all --timeout=8m

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do kill "${pid}" 2>/dev/null || true; done
}
trap cleanup EXIT

start_port_forward order-service 18086
pids+=("${PORT_FORWARD_PID}")
start_port_forward order-state-service 18087
pids+=("${PORT_FORWARD_PID}")

# A regular demo account buys one trading unit of a fictional stock at market.
response="$(curl -fsS -X POST http://127.0.0.1:18086/orders \
  -H 'Content-Type: application/json' \
  -d '{"accountId":"A00001","symbol":"D101","side":"BUY","orderType":"MARKET","quantity":100}')"
order_id="$(jq -er '.orderId' <<<"${response}")"
echo "Submitted smoke-test order: ${order_id}"

for _ in {1..90}; do
  if state="$(curl -fsS "http://127.0.0.1:18087/internal/orders/${order_id}" 2>/dev/null)"; then
    status="$(jq -r '.status' <<<"${state}")"
    pending="$(jq '[.executions[] | select(.buyingPowerReflectedAt == null or .tradeReportIssuedAt == null or .notificationDeliveredAt == null)] | length' <<<"${state}")"
    executions="$(jq '.executions | length' <<<"${state}")"
    echo "Observed status: ${status}, executions: ${executions}, awaiting downstream reflection: ${pending}"
    if [[ "${status}" == "FILLED" && "${executions}" -gt 0 && "${pending}" -eq 0 ]]; then
      echo "Order filled; buying power, trade report, and notification reflected for every execution."
      exit 0
    fi
  fi
  sleep 1
done

echo "Order did not reach FILLED with all executions reflected within 90 seconds." >&2
exit 1
