#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"

require_command podman

readonly SERVICE="${1:-order-service}"
readonly RUN_ID="$$"
readonly TAG_A="repro-${RUN_ID}-a"
readonly TAG_B="repro-${RUN_ID}-b"
readonly IMAGE_A="localhost/brokerage-demo/${SERVICE}:${TAG_A}"
readonly IMAGE_B="localhost/brokerage-demo/${SERVICE}:${TAG_B}"

sha256_file() {
  local path="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${path}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${path}" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "${path}" | awk '{print $NF}'
  else
    die "A SHA-256 tool is required: sha256sum, shasum, or openssl."
  fi
}

application_jar() {
  local -a jars=("${PROJECT_ROOT}/apps/${SERVICE}"/target/*.jar)
  if [[ ${#jars[@]} -ne 1 || ! -f "${jars[0]}" ]]; then
    die "Expected exactly one application jar for ${SERVICE}."
  fi
  printf '%s\n' "${jars[0]}"
}

cleanup_images() {
  podman image rm "${IMAGE_A}" "${IMAGE_B}" >/dev/null 2>&1 || true
}
trap cleanup_images EXIT

echo "Building ${SERVICE} twice with clean Maven output and disabled image cache."
TARGET=kind IMAGE_TAG="${TAG_A}" NO_CACHE=true \
  "${PROJECT_ROOT}/scripts/build-images" "${SERVICE}"
jar_hash_a="$(sha256_file "$(application_jar)")"
layers_a="$(podman image inspect "${IMAGE_A}" --format '{{json .RootFS.Layers}}')"

TARGET=kind IMAGE_TAG="${TAG_B}" NO_CACHE=true \
  "${PROJECT_ROOT}/scripts/build-images" "${SERVICE}"
jar_hash_b="$(sha256_file "$(application_jar)")"
layers_b="$(podman image inspect "${IMAGE_B}" --format '{{json .RootFS.Layers}}')"

if [[ "${jar_hash_a}" != "${jar_hash_b}" ]]; then
  die "Application jar digests differ across clean builds."
fi
if [[ "${layers_a}" != "${layers_b}" ]]; then
  printf 'First build layers:  %s\n' "${layers_a}" >&2
  printf 'Second build layers: %s\n' "${layers_b}" >&2
  die "Container filesystem layers differ across cache-free builds."
fi

echo "Reproducible jar: ${jar_hash_a}"
echo "Reproducible container filesystem layers: verified"
