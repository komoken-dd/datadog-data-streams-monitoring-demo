#!/usr/bin/env bash
set -Eeuo pipefail

source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
source "${PROJECT_ROOT}/config/container-images.sh"

require_command podman
require_command jq
require_command curl
require_command tar

verify_java_archive() {
  local kind="$1" architecture="$2" expected="$3"
  local archive_directory actual java_arch release_path
  case "${architecture}" in
    amd64) java_arch=x64 ;;
    arm64) java_arch=aarch64 ;;
    *) die "Unsupported Java archive architecture: ${architecture}" ;;
  esac
  archive_directory="$(mktemp -d "${TMPDIR:-/tmp}/brokerage-java-archive.XXXXXX")"
  if ! curl --fail --location --silent --show-error --retry 3 \
    "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13.1%2B2/OpenJDK21U-${kind}_${java_arch}_linux_hotspot_${JAVA_PATCHED_RELEASE}.tar.gz" \
    --output "${archive_directory}/java.tar.gz"; then
    rm -rf -- "${archive_directory}"
    die "Unable to obtain the locked Java ${kind}/${architecture} archive."
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "${archive_directory}/java.tar.gz" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "${archive_directory}/java.tar.gz" | awk '{print $1}')"
  fi
  if [[ "${actual}" != "${expected}" ]]; then
    rm -rf -- "${archive_directory}"
    die "Java archive checksum mismatch for ${kind}/${architecture}."
  fi
  release_path="$(tar -tzf "${archive_directory}/java.tar.gz" | awk '/\/release$/ {print}')"
  if ! tar -xOzf "${archive_directory}/java.tar.gz" "${release_path}" \
    | grep -Fx "JAVA_VERSION=\"${JAVA_PATCHED_VERSION}\"" >/dev/null; then
    rm -rf -- "${archive_directory}"
    die "Java archive version mismatch for ${kind}/${architecture}."
  fi
  rm -rf -- "${archive_directory}"
  echo "Verified Java ${JAVA_PATCHED_VERSION} ${kind}/${architecture} archive and release metadata."
}

verify_java_archive jdk amd64 "${JAVA_JDK_AMD64_SHA256}"
verify_java_archive jdk arm64 "${JAVA_JDK_ARM64_SHA256}"
verify_java_archive jre amd64 "${JAVA_JRE_AMD64_SHA256}"
verify_java_archive jre arm64 "${JAVA_JRE_ARM64_SHA256}"

verify_index_digest() {
  local image_name="$1"
  local image_tag="$2"
  local expected_digest="$3"
  local manifest

  manifest="$(podman manifest inspect "${image_name}@${expected_digest}")"
  jq -e \
    '[.manifests[].platform | select(.os == "linux") | .architecture]
     | (index("amd64") != null and index("arm64") != null)' \
    <<<"${manifest}" >/dev/null || {
      die "The locked image index lacks Linux AMD64 or ARM64: ${image_name}@${expected_digest}."
    }
  echo "Verified ${image_name}:${image_tag} multi-architecture index ${expected_digest}"
}

verify_platform_digest() {
  local image_name="$1"
  local image_tag="$2"
  local architecture="$3"
  local expected_digest="$4"
  local actual_digest

  actual_digest="$(podman manifest inspect --verbose "${image_name}:${image_tag}" \
    | jq -er --arg architecture "${architecture}" \
      '[.manifests[] | select(.platform.os == "linux" and .platform.architecture == $architecture)][0].digest')"
  if [[ "${actual_digest}" != "${expected_digest}" ]]; then
    die "Digest changed for ${image_name}:${image_tag} (${architecture}): expected ${expected_digest}, got ${actual_digest}."
  fi
  echo "Verified ${image_name}:${image_tag} (${architecture}) ${actual_digest}"
}

verify_config_digest() {
  local image_name="$1"
  local platform_digest="$2"
  local architecture="$3"
  local expected_config_digest="$4"
  local image_ref="${image_name}@${platform_digest}"
  local image_id
  local actual_config_digest

  podman pull --platform "linux/${architecture}" "${image_ref}" >/dev/null
  image_id="$(podman image inspect "${image_ref}" --format '{{.Id}}')"
  actual_config_digest="sha256:${image_id#sha256:}"
  if [[ "${actual_config_digest}" != "${expected_config_digest}" ]]; then
    die "Image config changed for ${image_ref}: expected ${expected_config_digest}, got ${actual_config_digest}."
  fi
  echo "Verified image config ${image_ref} ${actual_config_digest}"
}

verify_index_digest docker.io/library/maven "${MAVEN_IMAGE_TAG}" "${MAVEN_IMAGE_INDEX_DIGEST}"
verify_index_digest "${JAVA_RUNTIME_IMAGE_NAME}" "${JAVA_RUNTIME_IMAGE_TAG}" "${JAVA_RUNTIME_IMAGE_INDEX_DIGEST}"
verify_index_digest docker.io/kindest/node "${KIND_NODE_IMAGE_TAG}" "${KIND_NODE_IMAGE_INDEX_DIGEST}"
verify_index_digest "${POSTGRES_IMAGE_NAME}" "${POSTGRES_IMAGE_TAG}" "${POSTGRES_IMAGE_INDEX_DIGEST}"
verify_index_digest "${STRIMZI_OPERATOR_IMAGE_NAME}" "${STRIMZI_OPERATOR_IMAGE_TAG}" "${STRIMZI_OPERATOR_IMAGE_INDEX_DIGEST}"
verify_index_digest "${STRIMZI_KAFKA_IMAGE_NAME}" "${STRIMZI_KAFKA_IMAGE_TAG}" "${STRIMZI_KAFKA_IMAGE_INDEX_DIGEST}"
verify_index_digest "${DATADOG_OPERATOR_IMAGE_NAME}" "${DATADOG_OPERATOR_IMAGE_TAG}" "${DATADOG_OPERATOR_IMAGE_INDEX_DIGEST}"
verify_index_digest "${DATADOG_AGENT_IMAGE_NAME}" "${DATADOG_AGENT_IMAGE_TAG}" "${DATADOG_AGENT_IMAGE_INDEX_DIGEST}"
verify_index_digest "${DATADOG_CLUSTER_AGENT_IMAGE_NAME}" "${DATADOG_CLUSTER_AGENT_IMAGE_TAG}" "${DATADOG_CLUSTER_AGENT_IMAGE_INDEX_DIGEST}"
verify_index_digest "${DATADOG_JAVA_TRACER_IMAGE_NAME}" "${DATADOG_JAVA_TRACER_IMAGE_TAG}" "${DATADOG_JAVA_TRACER_IMAGE_INDEX_DIGEST}"
verify_index_digest "${DATADOG_APM_INJECT_IMAGE_NAME}" "${DATADOG_APM_INJECT_IMAGE_TAG}" "${DATADOG_APM_INJECT_IMAGE_INDEX_DIGEST}"

verify_platform_digest docker.io/library/maven "${MAVEN_IMAGE_TAG}" amd64 "${MAVEN_IMAGE_AMD64#*@}"
verify_platform_digest docker.io/library/maven "${MAVEN_IMAGE_TAG}" arm64 "${MAVEN_IMAGE_ARM64#*@}"
verify_platform_digest "${JAVA_RUNTIME_IMAGE_NAME}" "${JAVA_RUNTIME_IMAGE_TAG}" amd64 "${JAVA_RUNTIME_IMAGE_AMD64#*@}"
verify_platform_digest "${JAVA_RUNTIME_IMAGE_NAME}" "${JAVA_RUNTIME_IMAGE_TAG}" arm64 "${JAVA_RUNTIME_IMAGE_ARM64#*@}"
verify_platform_digest docker.io/kindest/node "${KIND_NODE_IMAGE_TAG}" amd64 "${KIND_NODE_IMAGE_AMD64#*@}"
verify_platform_digest docker.io/kindest/node "${KIND_NODE_IMAGE_TAG}" arm64 "${KIND_NODE_IMAGE_ARM64#*@}"
verify_platform_digest "${POSTGRES_IMAGE_NAME}" "${POSTGRES_IMAGE_TAG}" amd64 "${POSTGRES_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${STRIMZI_OPERATOR_IMAGE_NAME}" "${STRIMZI_OPERATOR_IMAGE_TAG}" amd64 "${STRIMZI_OPERATOR_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${STRIMZI_KAFKA_IMAGE_NAME}" "${STRIMZI_KAFKA_IMAGE_TAG}" amd64 "${STRIMZI_KAFKA_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${DATADOG_OPERATOR_IMAGE_NAME}" "${DATADOG_OPERATOR_IMAGE_TAG}" amd64 "${DATADOG_OPERATOR_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${DATADOG_AGENT_IMAGE_NAME}" "${DATADOG_AGENT_IMAGE_TAG}" amd64 "${DATADOG_AGENT_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${DATADOG_CLUSTER_AGENT_IMAGE_NAME}" "${DATADOG_CLUSTER_AGENT_IMAGE_TAG}" amd64 "${DATADOG_CLUSTER_AGENT_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${DATADOG_JAVA_TRACER_IMAGE_NAME}" "${DATADOG_JAVA_TRACER_IMAGE_TAG}" amd64 "${DATADOG_JAVA_TRACER_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${DATADOG_APM_INJECT_IMAGE_NAME}" "${DATADOG_APM_INJECT_IMAGE_TAG}" amd64 "${DATADOG_APM_INJECT_IMAGE_AMD64_DIGEST}"
verify_platform_digest "${POSTGRES_IMAGE_NAME}" "${POSTGRES_IMAGE_TAG}" arm64 "${POSTGRES_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${STRIMZI_OPERATOR_IMAGE_NAME}" "${STRIMZI_OPERATOR_IMAGE_TAG}" arm64 "${STRIMZI_OPERATOR_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${STRIMZI_KAFKA_IMAGE_NAME}" "${STRIMZI_KAFKA_IMAGE_TAG}" arm64 "${STRIMZI_KAFKA_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${DATADOG_OPERATOR_IMAGE_NAME}" "${DATADOG_OPERATOR_IMAGE_TAG}" arm64 "${DATADOG_OPERATOR_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${DATADOG_AGENT_IMAGE_NAME}" "${DATADOG_AGENT_IMAGE_TAG}" arm64 "${DATADOG_AGENT_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${DATADOG_CLUSTER_AGENT_IMAGE_NAME}" "${DATADOG_CLUSTER_AGENT_IMAGE_TAG}" arm64 "${DATADOG_CLUSTER_AGENT_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${DATADOG_JAVA_TRACER_IMAGE_NAME}" "${DATADOG_JAVA_TRACER_IMAGE_TAG}" arm64 "${DATADOG_JAVA_TRACER_IMAGE_ARM64_DIGEST}"
verify_platform_digest "${DATADOG_APM_INJECT_IMAGE_NAME}" "${DATADOG_APM_INJECT_IMAGE_TAG}" arm64 "${DATADOG_APM_INJECT_IMAGE_ARM64_DIGEST}"

verify_config_digest "${JAVA_RUNTIME_IMAGE_NAME}" "${JAVA_RUNTIME_IMAGE_AMD64#*@}" amd64 "${JAVA_RUNTIME_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${JAVA_RUNTIME_IMAGE_NAME}" "${JAVA_RUNTIME_IMAGE_ARM64#*@}" arm64 "${JAVA_RUNTIME_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${POSTGRES_IMAGE_NAME}" "${POSTGRES_IMAGE_AMD64_DIGEST}" amd64 "${POSTGRES_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${STRIMZI_OPERATOR_IMAGE_NAME}" "${STRIMZI_OPERATOR_IMAGE_AMD64_DIGEST}" amd64 "${STRIMZI_OPERATOR_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${STRIMZI_KAFKA_IMAGE_NAME}" "${STRIMZI_KAFKA_IMAGE_AMD64_DIGEST}" amd64 "${STRIMZI_KAFKA_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_OPERATOR_IMAGE_NAME}" "${DATADOG_OPERATOR_IMAGE_AMD64_DIGEST}" amd64 "${DATADOG_OPERATOR_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_AGENT_IMAGE_NAME}" "${DATADOG_AGENT_IMAGE_AMD64_DIGEST}" amd64 "${DATADOG_AGENT_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_CLUSTER_AGENT_IMAGE_NAME}" "${DATADOG_CLUSTER_AGENT_IMAGE_AMD64_DIGEST}" amd64 "${DATADOG_CLUSTER_AGENT_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_JAVA_TRACER_IMAGE_NAME}" "${DATADOG_JAVA_TRACER_IMAGE_AMD64_DIGEST}" amd64 "${DATADOG_JAVA_TRACER_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_APM_INJECT_IMAGE_NAME}" "${DATADOG_APM_INJECT_IMAGE_AMD64_DIGEST}" amd64 "${DATADOG_APM_INJECT_IMAGE_AMD64_CONFIG_DIGEST}"
verify_config_digest "${POSTGRES_IMAGE_NAME}" "${POSTGRES_IMAGE_ARM64_DIGEST}" arm64 "${POSTGRES_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${STRIMZI_OPERATOR_IMAGE_NAME}" "${STRIMZI_OPERATOR_IMAGE_ARM64_DIGEST}" arm64 "${STRIMZI_OPERATOR_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${STRIMZI_KAFKA_IMAGE_NAME}" "${STRIMZI_KAFKA_IMAGE_ARM64_DIGEST}" arm64 "${STRIMZI_KAFKA_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_OPERATOR_IMAGE_NAME}" "${DATADOG_OPERATOR_IMAGE_ARM64_DIGEST}" arm64 "${DATADOG_OPERATOR_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_AGENT_IMAGE_NAME}" "${DATADOG_AGENT_IMAGE_ARM64_DIGEST}" arm64 "${DATADOG_AGENT_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_CLUSTER_AGENT_IMAGE_NAME}" "${DATADOG_CLUSTER_AGENT_IMAGE_ARM64_DIGEST}" arm64 "${DATADOG_CLUSTER_AGENT_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_JAVA_TRACER_IMAGE_NAME}" "${DATADOG_JAVA_TRACER_IMAGE_ARM64_DIGEST}" arm64 "${DATADOG_JAVA_TRACER_IMAGE_ARM64_CONFIG_DIGEST}"
verify_config_digest "${DATADOG_APM_INJECT_IMAGE_NAME}" "${DATADOG_APM_INJECT_IMAGE_ARM64_DIGEST}" arm64 "${DATADOG_APM_INJECT_IMAGE_ARM64_CONFIG_DIGEST}"

echo "All reviewed image tags, platform manifests, and image configs match the lock."
